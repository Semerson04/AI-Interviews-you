    <!-- JavaScript Scripts -->
    <script>
        // Sparkles Particle Field Generation System
        function createSparkles() {
            const canvas = document.getElementById('cosmic-canvas');
            const sparkleCount = 75;
            for (let i = 0; i < sparkleCount; i++) {
                const sparkle = document.createElement('div');
                sparkle.className = 'sparkle';
                const x = Math.random() * 100;
                const y = Math.random() * 100;
                const size = Math.random() * 3.5 + 1;
                const delay = Math.random() * 5;
                const duration = Math.random() * 4 + 2;
                sparkle.style.left = `${x}%`;
                sparkle.style.top = `${y}%`;
                sparkle.style.width = `${size}px`;
                sparkle.style.height = `${size}px`;
                sparkle.style.animationDelay = `${delay}s`;
                sparkle.style.animationDuration = `${duration}s`;
                canvas.appendChild(sparkle);
            }
        }

        // Section Dropdown Toggle Actions
        function toggleSection(id) {
            const section = document.getElementById(id);
            section.classList.toggle('collapsed');
        }

        // Global Collapse / Expand Actions
        let allExpanded = true;
        const globalToggleBtn = document.getElementById('global-toggle');
        globalToggleBtn.addEventListener('click', () => {
            const sections = document.querySelectorAll('.collapsible-section');
            allExpanded = !allExpanded;
            sections.forEach(sec => {
                if (allExpanded) {
                    sec.classList.remove('collapsed');
                } else {
                    sec.classList.add('collapsed');
                }
            });
        });

        // Theme Toggle Persistence
        const themeToggleBtn = document.getElementById('theme-toggle');
        themeToggleBtn.addEventListener('click', () => {
            const isLight = document.documentElement.classList.toggle('light');
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
        });

        // Initialize elements on canvas ready
        document.addEventListener('DOMContentLoaded', () => {
            createSparkles();
            const canvas = document.getElementById('cosmic-canvas');
            const orbs = ['orb-1', 'orb-2', 'orb-3'];
            orbs.forEach(orbClass => {
                const orbElement = document.createElement('div');
                orbElement.className = `orb ${orbClass}`;
                canvas.appendChild(orbElement);
            });
        });
    </script>
</body>
</html>
