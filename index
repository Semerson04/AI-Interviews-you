    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #020617;
            --bg-grad: radial-gradient(circle at 50% 20%, #0f172a 0%, #020617 70%, #000000 100%);
            --surface: rgba(15, 23, 42, 0.75);
            --border: rgba(56, 189, 248, 0.15);
            --border-glow: rgba(56, 189, 248, 0.4);
            --text: #cbd5e1;
            --text-bright: #f8fafc;
            --text-dim: #64748b;
            
            /* Fabulous Cosmic Accents */
            --neon: #38bdf8;
            --cyan: #22d3ee;
            --green: #34d399;
            --amber: #fbbf24;
            --red: #f87171;
            --purple: #c084fc;
            --pink: #f472b6;
            
            --glass-bg: rgba(15, 23, 42, 0.65);
        }

        html.light {
            --bg: #f8fafc;
            --bg-grad: radial-gradient(circle at 50% 20%, #e2e8f0 0%, #f1f5f9 70%, #ffffff 100%);
            --surface: rgba(255, 255, 255, 0.85);
            --border: rgba(2, 132, 199, 0.2);
            --border-glow: rgba(2, 132, 199, 0.3);
            --text: #334155;
            --text-bright: #0f172a;
            --text-dim: #64748b;
            
            --neon: #0284c7;
            --cyan: #0891b2;
            --green: #059669;
            --amber: #d97706;
            --red: #dc2626;
            --purple: #7c3aed;
            --pink: #db2777;
            
            --glass-bg: rgba(248, 250, 252, 0.75);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--text);
            background-color: var(--bg);
            background-image: var(--bg-grad);
            line-height: 1.65;
            -webkit-font-smoothing: antialiased;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Subtle Cosmic Grid Overlay */
        .grid-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            background-size: 50px 50px;
            background-image: 
                linear-gradient(to right, var(--border) 1px, transparent 1px),
                linear-gradient(to bottom, var(--border) 1px, transparent 1px);
            opacity: 0.25;
            pointer-events: none;
        }

        /* Cosmic Canvas Container for Animated Elements */
        .cosmic-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
            overflow: hidden;
        }

        /* Glowing Nebula Orbs */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.15;
            mix-blend-mode: screen;
            animation: orbit 45s linear infinite;
        }
        .orb-1 { width: 500px; height: 500px; background: var(--purple); left: -100px; top: 5%; }
        .orb-2 { width: 600px; height: 600px; background: var(--cyan); right: -150px; top: 35%; animation-direction: reverse; animation-duration: 55s; }
        .orb-3 { width: 450px; height: 450px; background: var(--pink); left: 20%; bottom: -150px; animation-duration: 40s; }

        @keyframes orbit {
            0% { transform: translate(0, 0) rotate(0deg) scale(1); }
            50% { transform: translate(40px, 30px) rotate(180deg) scale(1.1); }
            100% { transform: translate(0, 0) rotate(360deg) scale(1); }
        }

        /* Big Fabulous Planets with Rings */
        .planet-container {
            position: absolute;
            user-select: none;
            will-change: transform;
            filter: drop-shadow(0 0 25px rgba(56, 189, 248, 0.25));
        }

        .giant-planet-1 {
            top: 8%;
            right: 5%;
            font-size: 7rem;
            animation: floatPlanet1 22s ease-in-out infinite;
        }

        .giant-planet-2 {
            bottom: 12%;
            left: 3%;
            font-size: 6rem;
            animation: floatPlanet2 28s ease-in-out infinite alternate;
        }

        .alien-ship {
            top: 40%;
            right: -10%;
            font-size: 3rem;
            animation: alienDrift 35s linear infinite;
        }

        .astronaut {
            top: 65%;
            right: 15%;
            font-size: 3rem;
            animation: astroFloat 18s ease-in-out infinite;
        }

        @keyframes floatPlanet1 {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-25px) rotate(10deg); }
        }
        @keyframes floatPlanet2 {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(30px) rotate(-12deg); }
        }
        @keyframes astroFloat {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            50% { transform: translate(-20px, -35px) rotate(-15deg); }
        }
        @keyframes alienDrift {
            0% { transform: translateX(0) translateY(0) rotate(0deg); }
            100% { transform: translateX(-120vw) translateY(-60px) rotate(360deg); }
        }

        /* Twinkling Sparkles */
        .sparkle {
            position: absolute;
            background: #ffffff;
            border-radius: 50%;
            animation: blink 3s infinite ease-in-out;
            box-shadow: 0 0 8px var(--cyan);
        }
        @keyframes blink {
            0%, 100% { opacity: 0.1; transform: scale(0.6); }
            50% { opacity: 1; transform: scale(1.4); background-color: var(--cyan); }
        }

        /* Sticky Frosted-Glass Header */
        header {
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            background: var(--glass-bg);
            border-bottom: 1px solid var(--border);
            transition: background 0.3s, border-color 0.3s;
        }

        .header-container {
            max-width: 880px;
            margin: 0 auto;
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand {
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--text-bright);
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .controls {
            display: flex;
            gap: 12px;
        }

        .icon-btn {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            color: var(--text-bright);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.25s ease;
        }

        .icon-btn:hover {
            border-color: var(--cyan);
            box-shadow: 0 0 12px var(--border-glow);
            color: var(--cyan);
            background: rgba(56, 189, 248, 0.1);
        }

        .icon-btn svg {
            width: 18px;
            height: 18px;
            fill: currentColor;
        }

        .sun-icon { display: none; }
        html.light .moon-icon { display: none; }
        html.light .sun-icon { display: block; }

        /* Main Content Container */
        .content-container {
            max-width: 880px;
            margin: 0 auto;
            padding: 40px 20px 80px;
            position: relative;
            z-index: 1;
        }

        /* Spaceship Cockpit Interior Dashboard Frame */
        .rocket-interior-frame {
            border: 1px solid var(--border);
            background: var(--surface);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 20px;
            padding: 45px;
            margin-bottom: 40px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), inset 0 0 40px rgba(56, 189, 248, 0.05);
            position: relative;
            overflow: hidden;
        }
        .rocket-interior-frame::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--neon), var(--cyan), var(--purple), var(--pink));
        }

        /* HUD Status Bar inside Cockpit */
        .hud-status {
            display: flex;
            gap: 20px;
            margin-bottom: 24px;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-dim);
            font-weight: 600;
        }
        .hud-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .hud-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 8px var(--green);
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 0.5; transform: scale(0.9); }
            50% { opacity: 1; transform: scale(1.2); }
        }

        /* Hero Section Styling */
        .hero {
            margin-bottom: 12px;
        }
        .hero h1 {
            font-size: 3.2rem;
            font-weight: 800;
            line-height: 1.12;
            color: var(--text-bright);
            letter-spacing: -0.03em;
            margin-bottom: 10px;
            background: linear-gradient(135deg, var(--text-bright) 40%, var(--neon) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .role-line {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--neon);
            margin-bottom: 20px;
            letter-spacing: -0.01em;
        }
        .hero-statement {
            font-size: 1.45rem;
            line-height: 1.5;
            color: var(--text-bright);
            margin-bottom: 32px;
            font-weight: 500;
        }

        /* Fabulous Call-To-Action Button */
        .cta-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.2) 0%, rgba(192, 132, 252, 0.2) 100%);
            border: 1px solid var(--neon);
            color: var(--text-bright);
            padding: 15px 30px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 4px 20px rgba(56, 189, 248, 0.15);
        }
        .cta-btn:hover {
            border-color: var(--cyan);
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.3) 0%, rgba(192, 132, 252, 0.3) 100%);
            box-shadow: 0 0 25px var(--border-glow);
            color: var(--cyan);
            transform: translateY(-2px);
        }

        a.inline-link {
            color: var(--neon);
            text-decoration: none;
            transition: all 0.2s ease;
        }
        a.inline-link:hover {
            color: var(--cyan);
            text-shadow: 0 0 10px var(--border-glow);
        }

        /* Collapsible Accordion Sections */
        .collapsible-section {
            border: 1px solid var(--border);
            background: var(--surface);
            backdrop-filter: blur(12px);
            border-radius: 16px;
            margin-bottom: 18px;
            overflow: hidden;
            transition: border-color 0.25s ease, box-shadow 0.25s ease;
        }
        .collapsible-section:hover {
            border-color: rgba(56, 189, 248, 0.35);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
        }
        .section-trigger {
            width: 100%;
            background: none;
            border: none;
            padding: 22px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            text-align: left;
            color: var(--text-bright);
        }
        .trigger-left {
            display: flex;
            align-items: center;
            gap: 18px;
        }
        .section-number {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--neon);
            background: rgba(56, 189, 248, 0.08);
        }
        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: -0.01em;
        }
        .toggle-icon {
            color: var(--text-dim);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .toggle-icon svg {
            width: 22px;
            height: 22px;
            fill: currentColor;
        }

        .section-content {
            max-height: 1000px;
            transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }
        .section-content-inner {
            padding: 0 28px 28px 82px;
            color: var(--text);
        }

        .collapsible-section.collapsed .section-content {
            max-height: 0 !important;
        }
        .collapsible-section.collapsed .toggle-icon {
            transform: rotate(-90deg);
        }

        /* Control Panel Grid Cards */
        .control-panel-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 18px;
            margin-top: 22px;
        }
        .panel-card {
            background: rgba(15, 23, 42, 0.4);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .panel-card:hover {
            transform: translateY(-2px);
            border-color: var(--cyan);
        }
        .panel-card h4 {
            color: var(--text-bright);
            margin-bottom: 8px;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Footer styling */
        footer {
            margin-top: 70px;
            border-top: 1px solid var(--border);
            padding-top: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: var(--text-dim);
            font-size: 0.85rem;
        }

        @media (max-width: 640px) {
            .hero h1 { font-size: 2.3rem; }
            .hero-statement { font-size: 1.2rem; }
            .section-content-inner { padding-left: 28px; }
            .header-container { padding: 14px 18px; }
            footer { flex-direction: column; gap: 12px; text-align: center; }
            .giant-planet-1 { font-size: 4rem; }
            .giant-planet-2 { font-size: 3.5rem; }
        }
    </style>

    <!-- Inline Theme Initializer to prevent flash -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            if (savedTheme === 'light') {
                document.documentElement.classList.add('light');
            }
        })();
    </script>
</head>
