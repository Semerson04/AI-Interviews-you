    <style>
        :root {
            --bg: #020a18;
            --bg-grad: linear-gradient(170deg, #020a18 0%, #041028 40%, #06142e 70%, #020a18 100%);
            --surface: rgba(8, 24, 56, 0.85);
            --border: rgba(0, 170, 255, 0.12);
            --border-glow: rgba(0, 170, 255, 0.3);
            --text: #d0e0f0;
            --text-bright: #e8f0ff;
            --text-dim: #6888aa;
            
            /* Accents */
            --neon: #00aaff;
            --cyan: #00e5ff;
            --green: #00ff88;
            --amber: #ffaa00;
            --red: #ff4466;
            --purple: #aa66ff;
            
            /* UI States */
            --glass-bg: rgba(4, 14, 36, 0.75);
        }

        html.light {
            --bg: #f0f4fa;
            --bg-grad: linear-gradient(170deg, #f0f4fa 0%, #e1e9f5 40%, #d2dff0 70%, #f0f4fa 100%);
            --surface: rgba(255, 255, 255, 0.85);
            --border: rgba(0, 110, 255, 0.15);
            --border-glow: rgba(0, 110, 255, 0.25);
            --text: #2a3b50;
            --text-bright: #0c1a30;
            --text-dim: #5c728d;
            
            /* Adjusted light accents for readability */
            --neon: #0077cc;
            --cyan: #0099aa;
            --green: #008844;
            --amber: #cc7700;
            --red: #cc2244;
            --purple: #7733cc;
            
            --glass-bg: rgba(240, 244, 250, 0.75);
        }

        /* Prevent flash on load */
        body {
            background-color: var(--bg);
            background-image: var(--bg-grad);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--text);
            line-height: 1.65;
            -webkit-font-smoothing: antialiased;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* 1. Fixed full-page background gradient applied to HTML/Body */
        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -3;
            background: var(--bg-grad);
        }

        /* 2. Subtle 60px grid overlay */
        .grid-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            background-size: 60px 60px;
            background-image: 
                linear-gradient(to right, var(--border) 1px, transparent 1px),
                linear-gradient(to bottom, var(--border) 1px, transparent 1px);
            opacity: 0.3;
            pointer-events: none;
        }

        /* 3. Cosmic Moving Elements Container */
        .cosmic-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
            overflow: hidden;
        }

        /* Large Orbiting Blurred Orbs (Rendered strictly outside main 880px content column or subtly in background bounds) */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.08;
            mix-blend-mode: screen;
            animation: orbit 40s linear infinite;
        }
        .orb-1 {
            width: 400px;
            height: 400px;
            background: var(--neon);
            left: -200px;
            top: 10%;
        }
        .orb-2 {
            width: 500px;
            height: 500px;
            background: var(--purple);
            right: -250px;
            top: 40%;
            animation-direction: reverse;
            animation-duration: 50s;
        }
        .orb-3 {
            width: 350px;
            height: 350px;
            background: var(--cyan);
            left: -150px;
            bottom: 10%;
            animation-duration: 60s;
        }

        @keyframes orbit {
            0% { transform: translate(0, 0) rotate(0deg); }
            50% { transform: translate(50px, 30px) rotate(180deg); }
            100% { transform: translate(0, 0) rotate(360deg); }
        }

        /* Moving Planets, Sparkles, Aliens, Astronauts */
        .cosmic-element {
            position: absolute;
            user-select: none;
            will-change: transform;
        }

        /* Floating elements with keyframes */
        .planet-1 { top: 15%; right: 8%; font-size: 3rem; animation: floatSlow 18s ease-in-out infinite; }
        .planet-2 { bottom: 25%; left: 5%; font-size: 2.5rem; animation: floatSlow 24s ease-in-out infinite alternate; }
        .alien-ship { top: 45%; right: 5%; font-size: 2.2rem; animation: alienDrift 30s linear infinite; }
        .astronaut { top: 70%; right: 12%; font-size: 2.5rem; animation: astroFloat 20s ease-in-out infinite; }

        @keyframes floatSlow {
            0% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(15deg); }
            100% { transform: translateY(0) rotate(0deg); }
        }
        @keyframes astroFloat {
            0% { transform: translate(0, 0) rotate(0deg); }
            50% { transform: translate(-15px, -30px) rotate(-20deg); }
            100% { transform: translate(0, 0) rotate(0deg); }
        }
        @keyframes alienDrift {
            0% { transform: translateX(100vw) translateY(0) rotate(0deg); }
            100% { transform: translateX(-10vw) translateY(-50px) rotate(360deg); }
        }

        /* Sparkles Generator Target styles */
        .sparkle {
            position: absolute;
            background: #fff;
            border-radius: 50%;
            animation: blink 3s infinite ease-in-out;
        }
        @keyframes blink {
            0%, 100% { opacity: 0.2; transform: scale(0.8); }
            50% { opacity: 1; transform: scale(1.2); background-color: var(--cyan); }
        }

        /* Sticky Frosted-Glass Header */
        header {
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            background: var(--glass-bg);
            border-bottom: 1px solid var(--border);
            transition: background 0.3s, border-color 0.3s;
        }

        .header-container {
            max-width: 880px;
            margin: 0 auto;
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand {
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--text-bright);
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .controls {
            display: flex;
            gap: 12px;
        }

        .icon-btn {
            background: none;
            border: 1px solid var(--border);
            color: var(--text-bright);
            width: 38px;
            height: 38px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .icon-btn:hover {
            border-color: var(--cyan);
            box-shadow: 0 0 8px var(--border-glow);
            color: var(--cyan);
        }

        .icon-btn svg {
            width: 18px;
            height: 18px;
            fill: currentColor;
        }

        /* Theme Toggle Icon Conditions */
        .sun-icon { display: none; }
        html.light .moon-icon { display: none; }
        html.light .sun-icon { display: block; }

        /* Main Content Layout Container */
        .content-container {
            max-width: 880px;
            margin: 0 auto;
            padding: 40px 20px 80px;
            position: relative;
            z-index: 1;
        }

        /* Rocket Interior Cockpit Framing Style (Subtle Dashboard Indicator accents) */
        .rocket-interior-frame {
            border: 1px solid var(--border);
            background: var(--surface);
            border-radius: 16px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: inset 0 0 30px rgba(0, 170, 255, 0.05);
            position: relative;
